generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BonsaiStatus {
  ACTIVE
  RECOVERING
  DORMANT
}

enum CollectionStatus {
  ACTIVE
  DECEASED
  SOLD
  GIFTED
  OTHER
}

enum CareEventType {
  WATERING
  FERTILIZING
  PRUNING
  PINCHING
  REPOTTING
  WIRING
  DEFOLIATION
  PEST_TREATMENT
}

enum ReminderType {
  WATERING
  FERTILIZING
  PRUNING
  REPOTTING
  WIRING
  HEALTH_CHECK
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                  String     @id @default(cuid())
  clerkId             String?    @unique
  name                String?
  email               String     @unique
  emailVerified       DateTime?
  image               String?
  role                UserRole   @default(USER)
  collectionLocation  String?
  isCollectionPublic  Boolean    @default(true)
  showCareInPublic    Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  bonsais             Bonsai[]
  reminders           Reminder[]
  accounts            Account[]
  sessions            Session[]
}

model Bonsai {
  id                    String           @id @default(cuid())
  userId                String
  name                  String
  species               String
  style                 String?
  acquiredAt            DateTime?
  ageAtAcquisitionYears Int?
  location              String?
  notes                 String?
  status                BonsaiStatus     @default(ACTIVE)
  collectionStatus CollectionStatus @default(ACTIVE)
  isPublic              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  careEvents            CareEvent[]
  healthIssues          HealthIssue[]
  journal               JournalEntry[]
  photos                Photo[]
  reminders             Reminder[]

  @@index([userId, name])
}

model CareEvent {
  id          String        @id @default(cuid())
  bonsaiId    String
  type        CareEventType
  performedAt DateTime
  title       String?
  notes       String?
  createdAt   DateTime      @default(now())
  bonsai      Bonsai        @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)
  photos      CareEventPhoto[]

  @@index([bonsaiId, performedAt])
}

model CareEventPhoto {
  id          String    @id @default(cuid())
  careEventId String
  imageUrl    String
  caption     String?
  isPrimary   Boolean   @default(false)
  takenAt     DateTime  @default(now())
  createdAt   DateTime  @default(now())
  careEvent   CareEvent @relation(fields: [careEventId], references: [id], onDelete: Cascade)

  @@index([careEventId, takenAt])
  @@index([careEventId, isPrimary])
}

model HealthIssue {
  id          String   @id @default(cuid())
  bonsaiId    String
  title       String
  description String?
  detectedAt  DateTime @default(now())
  resolvedAt  DateTime?
  severity    String?
  createdAt   DateTime @default(now())
  bonsai      Bonsai   @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId, detectedAt])
}

model JournalEntry {
  id        String   @id @default(cuid())
  bonsaiId  String
  title     String?
  content   String
  entryDate DateTime @default(now())
  createdAt DateTime @default(now())
  bonsai    Bonsai   @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId, entryDate])
}

model Photo {
  id          String   @id @default(cuid())
  bonsaiId    String
  imageUrl    String
  caption     String?
  isPrimary   Boolean  @default(false)
  takenAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  bonsai      Bonsai   @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId, takenAt])
  @@index([bonsaiId, isPrimary])
}

model Reminder {
  id          String       @id @default(cuid())
  userId      String
  bonsaiId    String?
  type        ReminderType
  title       String
  description String?
  dueAt       DateTime
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bonsai      Bonsai?      @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([bonsaiId, dueAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@unique([token])
}
