generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BonsaiStatus {
  ACTIVE
  RECOVERING
  DORMANT
}

enum CollectionStatus {
  ACTIVE
  DECEASED
  SOLD
  GIFTED
  OTHER
}

enum CareEventType {
  WATERING
  FERTILIZING
  PRUNING
  PINCHING
  REPOTTING
  WIRING
  DEFOLIATION
  PEST_TREATMENT
}

enum ReminderType {
  WATERING
  FERTILIZING
  PRUNING
  REPOTTING
  WIRING
  HEALTH_CHECK
}

enum SpeciesPlacement {
  OUTDOOR
  INDOOR
  OUTDOOR_PROTECTED
  GREENHOUSE
}

enum LightExposure {
  FULL_SUN
  PARTIAL_SUN
  BRIGHT_SHADE
  SHADE
  INDOOR_BRIGHT
}

enum DrainageLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                  String     @id @default(cuid())
  clerkId             String?    @unique
  name                String?
  email               String     @unique
  emailVerified       DateTime?
  image               String?
  role                UserRole   @default(USER)
  collectionLocation  String?
  isCollectionPublic  Boolean    @default(true)
  showCareInPublic    Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  bonsais             Bonsai[]
  reminders           Reminder[]
  bonsaiVotes         BonsaiVote[]
  bonsaiComments      BonsaiComment[]
  accounts            Account[]
  sessions            Session[]
}

model Bonsai {
  id                    String           @id @default(cuid())
  userId                String
  speciesId             String?
  name                  String
  species               String
  style                 String?
  acquiredAt            DateTime?
  ageAtAcquisitionYears Int?
  location              String?
  notes                 String?
  status                BonsaiStatus     @default(ACTIVE)
  collectionStatus CollectionStatus @default(ACTIVE)
  isPublic              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  speciesReference      Species?         @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  careEvents            CareEvent[]
  healthIssues          HealthIssue[]
  journal               JournalEntry[]
  photos                Photo[]
  reminders             Reminder[]
  votes                 BonsaiVote[]
  comments              BonsaiComment[]

  @@index([userId, name])
  @@index([speciesId])
}

model Species {
  id                      String            @id @default(cuid())
  slug                    String            @unique
  placementType           SpeciesPlacement?
  lightExposure           LightExposure?
  sunHours                Int?
  minTemperatureC         Int?
  maxTemperatureC         Int?
  wateringFrequencyDays   Json?
  fertilizingActiveMonths Json?
  fertilizingFrequencyDays Int?
  pruningActiveMonths     Json?
  pruningFrequencyDays    Int?
  repottingActiveMonths   Json?
  repottingFrequencyDays  Int?
  substrateDrainage       DrainageLevel?
  risks                   Json?
  sourceName              String?
  sourceUrl               String?
  sourceExternalId        String?
  isPublished             Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  bonsais                 Bonsai[]
  translations            SpeciesTranslation[]
}

model SpeciesTranslation {
  id                String   @id @default(cuid())
  speciesId         String
  locale            String
  commonName        String
  scientificName    String
  placementNotes    String?  @db.Text
  temperatureNotes  String?  @db.Text
  wateringNotes     String?  @db.Text
  fertilizingNotes  String?  @db.Text
  pruningNotes      String?  @db.Text
  repottingNotes    String?  @db.Text
  substrateNotes    String?  @db.Text
  species           Species  @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@unique([speciesId, locale])
  @@index([locale, commonName])
  @@index([locale, scientificName])
}

model BonsaiVote {
  id        String   @id @default(cuid())
  userId    String
  bonsaiId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bonsai    Bonsai   @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@unique([userId, bonsaiId])
  @@index([bonsaiId, createdAt])
  @@index([userId, createdAt])
}

model BonsaiComment {
  id              String          @id @default(cuid())
  bonsaiId        String
  authorId        String
  parentCommentId String?
  content         String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  bonsai          Bonsai          @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)
  author          User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment   BonsaiComment?  @relation("BonsaiCommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         BonsaiComment[] @relation("BonsaiCommentReplies")

  @@index([bonsaiId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentCommentId, createdAt])
}

model CareEvent {
  id          String        @id @default(cuid())
  bonsaiId    String
  type        CareEventType
  performedAt DateTime
  title       String?
  notes       String?
  createdAt   DateTime      @default(now())
  bonsai      Bonsai        @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)
  photos      CareEventPhoto[]

  @@index([bonsaiId, performedAt])
}

model CareEventPhoto {
  id          String    @id @default(cuid())
  careEventId String
  imageUrl    String
  caption     String?
  isPrimary   Boolean   @default(false)
  takenAt     DateTime  @default(now())
  createdAt   DateTime  @default(now())
  careEvent   CareEvent @relation(fields: [careEventId], references: [id], onDelete: Cascade)

  @@index([careEventId, takenAt])
  @@index([careEventId, isPrimary])
}

model HealthIssue {
  id          String   @id @default(cuid())
  bonsaiId    String
  title       String
  description String?
  detectedAt  DateTime @default(now())
  resolvedAt  DateTime?
  severity    String?
  createdAt   DateTime @default(now())
  bonsai      Bonsai   @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId, detectedAt])
}

model JournalEntry {
  id        String   @id @default(cuid())
  bonsaiId  String
  title     String?
  content   String
  entryDate DateTime @default(now())
  createdAt DateTime @default(now())
  bonsai    Bonsai   @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId, entryDate])
}

model Photo {
  id          String   @id @default(cuid())
  bonsaiId    String
  imageUrl    String
  caption     String?
  isPrimary   Boolean  @default(false)
  takenAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  bonsai      Bonsai   @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId, takenAt])
  @@index([bonsaiId, isPrimary])
}

model Reminder {
  id          String       @id @default(cuid())
  userId      String
  bonsaiId    String?
  type        ReminderType
  title       String
  description String?
  dueAt       DateTime
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bonsai      Bonsai?      @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([bonsaiId, dueAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@unique([token])
}
