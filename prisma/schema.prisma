generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BonsaiStatus {
  ACTIVE
  RECOVERING
  DORMANT
}

enum CareEventType {
  WATERING
  FERTILIZING
  PRUNING
  REPOTTING
  WIRING
}

enum ReminderType {
  WATERING
  FERTILIZING
  PRUNING
  REPOTTING
  WIRING
  HEALTH_CHECK
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          UserRole   @default(USER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  bonsais       Bonsai[]
  reminders     Reminder[]
  accounts      Account[]
  sessions      Session[]
}

model Bonsai {
  id           String         @id @default(cuid())
  userId       String
  name         String
  species      String
  style        String?
  acquiredAt   DateTime?
  location     String?
  notes        String?
  status       BonsaiStatus   @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  careEvents   CareEvent[]
  healthIssues HealthIssue[]
  journal      JournalEntry[]
  photos       Photo[]
  reminders    Reminder[]

  @@index([userId, name])
}

model CareEvent {
  id          String        @id @default(cuid())
  bonsaiId    String
  type        CareEventType
  performedAt DateTime
  title       String?
  notes       String?
  createdAt   DateTime      @default(now())
  bonsai      Bonsai        @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId, performedAt])
}

model HealthIssue {
  id          String   @id @default(cuid())
  bonsaiId    String
  title       String
  description String?
  detectedAt  DateTime @default(now())
  resolvedAt  DateTime?
  severity    String?
  createdAt   DateTime @default(now())
  bonsai      Bonsai   @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId, detectedAt])
}

model JournalEntry {
  id        String   @id @default(cuid())
  bonsaiId  String
  title     String?
  content   String
  entryDate DateTime @default(now())
  createdAt DateTime @default(now())
  bonsai    Bonsai   @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId, entryDate])
}

model Photo {
  id          String   @id @default(cuid())
  bonsaiId    String
  imageUrl    String
  caption     String?
  takenAt     DateTime @default(now())
  createdAt   DateTime @default(now())
  bonsai      Bonsai   @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([bonsaiId, takenAt])
}

model Reminder {
  id          String       @id @default(cuid())
  userId      String
  bonsaiId    String?
  type        ReminderType
  title       String
  description String?
  dueAt       DateTime
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bonsai      Bonsai?      @relation(fields: [bonsaiId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([bonsaiId, dueAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@unique([token])
}
